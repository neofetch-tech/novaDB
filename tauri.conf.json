{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovaDB",
  "version": "0.1.0",
  "identifier": "io.novadb.desktop",
  "build": { 
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1", 
    "devUrl": "http://127.0.0.1:5173", 
    "beforeBuildCommand": "npm run build", 
    "frontendDist": "../dist"
  },
  "app": { 
    "windows": [{ 
      "title": "NovaDB", 
      "width": 1440, 
      "height": 930, 
      "minWidth": 1100, 
      "minHeight": 700,
      "decorations": true
    }]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
